# Copy to .env and fill in. Never commit .env.

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=legal_rag
# Optional: search several collections at once (same embedding). Empty = COLLECTION_NAME only.
COLLECTION_NAMES=

# Optional Cloudflare Access headers when Qdrant sits behind Access.
# Leave unset on a local Docker network.
QDRANT_CF_ACCESS_CLIENT_ID=
QDRANT_CF_ACCESS_CLIENT_SECRET=
QDRANT_CF_ACCESS_TOKEN=

# --- Embeddings / rerank ---
EMBED_MODEL=intfloat/multilingual-e5-large
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RAG_RERANK=1
# Optional GPU embedding for batch ingest only (requires the `modal` SDK).
EMBED_BACKEND=
RAG_POOLS_SEPARADOS=0
RAG_PENALIDADE_SINTETICO=0.0

# --- MCP HTTP ---
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_HTTP_PATH=/mcp
# Secret for the MCP endpoint (>=16 chars). Sent as: Authorization: Bearer <token>
MCP_AUTH_TOKEN=change-me-min-16-chars
# Comma-separated Host values allowed by DNS-rebinding protection. Empty disables the Host check.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional generation (tool `answer`) ---
LLM_PROVIDER=claude-cli
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
RAG_CLAUDE_HOME=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Caches ---
HF_HOME=./models
FASTEMBED_CACHE_DIR=./models
HF_HUB_DISABLE_SHARED_BLOBS=1
